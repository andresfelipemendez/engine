{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Migration: Build, run tests, and show coverage",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/coverage.ps1"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Migration: Build instrumented tests",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/coverage.ps1", "-Action", "Build"],
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Migration: Show coverage",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/coverage.ps1", "-Action", "Report"],
            "problemMatcher": []
        }
    ]
}
