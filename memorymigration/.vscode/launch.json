{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Migration: Run tests and show coverage",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/migration_tests.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "LLVM_PROFILE_FILE", "value": "${workspaceFolder}/build/migration.profraw" }
            ],
            "preLaunchTask": "Migration: Build instrumented tests",
            "postDebugTask": "Migration: Show coverage"
        }
    ]
}
